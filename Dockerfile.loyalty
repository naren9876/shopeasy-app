FROM python:3.9-slim

WORKDIR /app

# Install Flask
RUN pip install --no-cache-dir flask==2.3.0 requests==2.31.0

# Copy application
COPY loyalty-service.py .

# Create non-root user for security
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:5002/health')"

EXPOSE 5002

ENV SERVICE_NAME=loyalty-service
ENV SERVICE_VERSION=1.0.0
ENV ENVIRONMENT=production
ENV LOG_LEVEL=INFO
ENV PORT=5002

CMD ["python", "loyalty-service.py"]
